# Copiar a .env y ajustar. El .env real no va al repo.

# Puerto del servidor.
PORT=3001

# development | production
# En production: cookies con secure=true (requiere HTTPS) y se sirve el front
# compilado desde web/dist en el mismo proceso.
NODE_ENV=development

# Dónde vive la base. En Docker apuntá a un volumen persistente.
# Si no se define, usa <server>/data/hormiga.db
# DATABASE_PATH=/data/hormiga.db

# IMPORTANTE ANTES DE EXPONER ESTO A INTERNET
# -------------------------------------------
# Si está definida, hace falta este código para crear una cuenta nueva.
# Sin esto, cualquiera que encuentre la URL puede registrarse en tu servidor.
# Poné algo largo y random, compartilo solo con tu pareja, y una vez que los
# dos tengan cuenta podés cambiarlo por cualquier cosa para cerrar el registro.
# REGISTRATION_CODE=cambiame-por-algo-largo-y-random
